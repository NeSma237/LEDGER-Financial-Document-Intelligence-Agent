# Langfuse (leave unset to run with tracing disabled / no-op)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Where to store the held-out benchmark set and run results
EVAL_DATA_DIR=./data

# Base URL of orchestrator-api
ORCHESTRATOR_URL=http://localhost:8000

# Base URL of retrieval-api — only used for the Recall@K/Precision@K
# retrieval-quality track, called directly (bypasses orchestrator, will be changed to orchestrator in the future)
RETRIEVAL_URL=http://localhost:8002
